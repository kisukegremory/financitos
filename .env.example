# --- OpenRouter ---
# Crie sua chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-coloque-sua-chave-aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo principal (barato e bom em extração estruturada)
OPENROUTER_MODEL=deepseek/deepseek-chat
# Modelo reserva, usado se o principal falhar (Xiaomi MiMo no radar)
OPENROUTER_FALLBACK_MODEL=xiaomi/mimo-v2-flash

# --- Armazenamento ---
DATABASE_URL=sqlite:///data/financitos.db

# --- Geral ---
LOG_LEVEL=INFO
